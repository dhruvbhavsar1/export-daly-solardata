# ===== Yalgaar login (no username/password needed) =====
YALGAAR_CLIENT_KEY=PUT_YOUR_CLIENT_KEY_HERE
# PC and GitHub must use DIFFERENT uuids (letters, digits, - @ _). GitHub uses solarpulse-gha.
YALGAAR_UUID=solarpulse-pc
LOGGER_SERIAL=1380242000046
# YALGAAR_CHANNEL=            # empty = same as LOGGER_SERIAL
YALGAAR_SSL=false

# ===== Plant details shown in the report (optional) =====
CLIENT_NAME=
PLANT_ADDRESS=
PLANT_ID=
INVERTER=
# PLANT_KWP=                  # leave empty until known (specific yield then shows N/A)
TARIFF_INR=7

# ===== Old collector.py / mqtt_test.py only (not used by the daily report) =====
MQTT_BROKER=api.yalgaar.io
MQTT_PORT=1883
MQTT_USERNAME=solarbot
MQTT_PASSWORD=
MQTT_TOPIC=solar/1380242000046

# Never put the Gmail password here. It lives only in GitHub Secrets (SMTP_PASS).
