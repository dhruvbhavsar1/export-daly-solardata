# Copy this file to ".env" and fill it in. NEVER commit ".env" and never paste it in a chat.
# Check it safely with:  python scripts/check_env.py

# --- Yalgaar (the data source) ---
YALGAAR_CLIENT_KEY=
# Every machine that listens needs its OWN uuid (letters, digits, - @ _). PC and server must differ.
YALGAAR_UUID=solarpulse-pc
YALGAAR_SSL=false
# Channel(s) that carry the loggers' data (all devices publish on this one)
YALGAAR_CHANNELS=1380242000046

# --- Report settings ---
WINDOW_START=07:00
WINDOW_END=18:00
RAW_KEEP_DAYS=90
TARIFF_INR=7
CO2_KG_PER_KWH=0.82
# Assumed peak sun hours per day, used for the performance ratio (override per plant in plants.json)
PSH_HOURS_PER_DAY=4.5
# false = only MAIL_TO gets the reports. true = each logger's own "emails" list in loggers.json gets its report too.
SEND_TO_CLIENTS=false

# --- E-mail (Gmail: use an app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Several addresses separated by commas, no spaces
MAIL_TO=
