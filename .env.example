# ===== Yalgaar login (no username/password needed) =====
YALGAAR_CLIENT_KEY=PUT_YOUR_CLIENT_KEY_HERE
# Each machine that listens needs its OWN uuid (letters, digits, - @ _): PC = solarpulse-pc, server = solarpulse-srv
YALGAAR_UUID=solarpulse-pc
YALGAAR_SSL=false
# Channel(s) that carry the loggers' data (all your devices publish on this one)
YALGAAR_CHANNELS=1380242000046

# ===== Service =====
WINDOW_START=07:00
WINDOW_END=18:00
RAW_KEEP_DAYS=90
TARIFF_INR=7
# false = every report email goes only to MAIL_TO (you). true = each logger's own "emails" in loggers.json.
SEND_TO_CLIENTS=false

# ===== Email (Gmail app password; this file stays on this machine only) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=            # several addresses separated by commas, no spaces

# ===== Old collector.py / mqtt_test.py only (not used by the service) =====
LOGGER_SERIAL=1380242000046
MQTT_BROKER=api.yalgaar.io
MQTT_PORT=1883
MQTT_USERNAME=solarbot
MQTT_PASSWORD=
MQTT_TOPIC=solar/1380242000046
